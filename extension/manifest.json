{
  "manifest_version": 3,
  "name": "Redint",
  "version": "1.0.2",
  "description": "Open Reddit profiles in Rosint from a link or a hidden profile page.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.reddit.com/*"],
      "js": ["profile.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
